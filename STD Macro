-- Helper function to generate filtered and alphabetically sorted unit lists
local function GetFilteredDropdownKeys(filterText)
    local keys = {"Custom ID Input"}
    for name, _ in pairs(UnitDatabase) do
        if not filterText or filterText == "" or string.find(string.lower(name), string.lower(filterText)) then
            table.insert(keys, name)
        end
    end
    table.sort(keys, function(a, b)
        if a == "Custom ID Input" then return true end
        if b == "Custom ID Input" then return false end
        return a < b
    end)
    return keys
end

local function AdvancedUpgrade(TargetName)
   if not UpgradeTowerFunction then return end
   local folders = {Workspace:FindFirstChild("Towers"), Workspace:FindFirstChild("PlacedTowers"), Workspace:FindFirstChild("Units"), Workspace}
   for _, folder in pairs(folders) do
      if folder then
         for _, Object in pairs(folder:GetChildren()) do
            if Object and Object.Name and string.find(string.lower(Object.Name), string.lower(TargetName)) then
               task.spawn(function() UpgradeTowerFunction:InvokeServer(Object) end)
               task.wait(0.01)
            end
         end
      end
   end
end


RunService.RenderStepped:Connect(function()
   if PlacerActive and PreviewPart and Mouse then
      local rayOrigin = Mouse.UnitRay.Origin
      local rayDirection = Mouse.UnitRay.Direction * 500
      local raycastParams = RaycastParams.new()
      raycastParams.FilterFilterType = Enum.RaycastFilterType.Exclude
      raycastParams.FilterDescendantsInstances = {PreviewPart, LocalPlayer.Character}
      
      local raycastResult = Workspace:Raycast(rayOrigin, rayDirection, raycastParams)
      
      if raycastResult then
         PreviewPart.Position = raycastResult.Position + Vector3.new(0, 0.5, 0)
      else
         PreviewPart.Position = Mouse.Hit.Position + Vector3.new(0, 0.5, 0)
      end
   end
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
   if gameProcessed or not PlacerActive or not PreviewPart then return end
   
   if input.UserInputType == Enum.UserInputType.MouseButton1 then
      if SpawnTowerFunction and SelectedTowerID ~= "" then
         local TargetPosition = PreviewPart.Position
         local PlacementCFrame = CFrame.new(TargetPosition.X, TargetPosition.Y, TargetPosition.Z, -1, 0, -8.7422776573476e-08, 0, 1, 0, 8.7422776573476e-08, 0, -1)
         
         task.spawn(function()
            SpawnTowerFunction:InvokeServer(SelectedTowerID, PlacementCFrame, nil)
         end)
         
         PlacerToggle:Set(false)
      end
   end
end)


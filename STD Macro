      RemoveTextAfterFocusLost = false,
      Flag = "Tab3_SecretID_" .. tostring(i),
      Callback = function() end
   })

   local coordLbl3 = CustomTab3:CreateLabel("No target coordinates logged.")

   CustomTab3:CreateButton({
      Name = "Position (Select Position using Player's Position)",
      Interact = "Record",
      Callback = function()
         if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local RootPart = LocalPlayer.Character.HumanoidRootPart
            local Point = RootPart.Position
            local ComputedCFrame = CFrame.new(Point.X, Point.Y - 3.2, Point.Z, -1, 0, -8.7422776573476e-08, 0, 1, 0, 8.7422776573476e-08, 0, -1)
            PositionsTab3[i] = ComputedCFrame
            coordLbl3:Set(string.format("Vector: %.2f, %.2f, %.2f", Point.X, Point.Y, Point.Z))
         end
      end
   })
   CustomTab3:CreateDivider()
end

CustomTab3:CreateSection("Execution Sequence")
CustomTab3:CreateButton({
   Name = "RUN PROFILE DEPLOYMENT SEQUENCE",
   Interact = "Execute Matrix",
   Callback = function()
      if not SpawnTowerFunction then return end
      for i = 1, 10 do
         local selOpt = Rayfield.Flags["Tab3_UnitSelect_" .. tostring(i)] and Rayfield.Flags["Tab3_UnitSelect_" .. tostring(i)].CurrentOption[1] or ""
         local targetID = ""

         if selOpt == "Custom ID Input" then
            targetID = Rayfield.Flags["Tab3_SecretID_" .. tostring(i)] and Rayfield.Flags["Tab3_SecretID_" .. tostring(i)].CurrentValue or ""
         elseif UnitDatabase[selOpt] then
            targetID = UnitDatabase[selOpt].ID
         end

         local baseCF = PositionsTab3[i]

         if targetID ~= "" and baseCF then
            if selOpt == "Sorcerer Agent" and i == 1 then
               task.spawn(function()
                  for agentCount = 0, 3 do
                     local staggeredCF = baseCF * CFrame.new(agentCount * 4, 0, 0)
                     SpawnTowerFunction:InvokeServer(targetID, staggeredCF, nil)
                     task.wait(0.1)
                  end
               end)
            else
               task.spawn(function()
                  SpawnTowerFunction:InvokeServer(targetID, baseCF, nil)
               end)
            end
            task.wait(0.1)
         end
      end
   end
})

Rayfield:LoadConfiguration()

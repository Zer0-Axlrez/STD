-- Helper function to generate filtered and alphabetically sorted unit lists
local function GetFilteredDropdownKeys(filterText)
    local keys = {"Custom ID Input"}
    for name, _ in pairs(UnitDatabase) do
        if not filterText or filterText == "" or string.find(string.lower(name), string.lower(filterText)) then
            table.insert(keys, name)
        end
    end
    table.sort(keys, function(a, b)
        if a == "Custom ID Input" then return true end
        if b == "Custom ID Input" then return false end
        return a < b
    end)
    return keys
end

local function AdvancedUpgrade(TargetName)
   if not UpgradeTowerFunction then return end
   local folders = {Workspace:FindFirstChild("Towers"), Workspace:FindFirstChild("PlacedTowers"), Workspace:FindFirstChild("Units"), Workspace}
   for _, folder in pairs(folders) do
      if folder then
         for _, Object in pairs(folder:GetChildren()) do
            if Object and Object.Name and string.find(string.lower(Object.Name), string.lower(TargetName)) then
               task.spawn(function() UpgradeTowerFunction:InvokeServer(Object) end)
               task.wait(0.01)
            end
         end
      end
   end
end

-- Helper execution sequence runner for sequential placement and upgrading
local function RunCustomFarmLoop(positionsTable, prefix)
    if not SpawnTowerFunction then return end
    
    local placedData = {}

    for i = 1, 10 do
        local selOpt = Rayfield.Flags[prefix .. "_UnitSelect_" .. tostring(i)] and Rayfield.Flags[prefix .. "_UnitSelect_" .. tostring(i)].CurrentOption[1] or ""
        local targetID = ""
        local unitRecord = nil

        if selOpt == "Custom ID Input" then
            targetID = Rayfield.Flags[prefix .. "_SecretID_" .. tostring(i)] and Rayfield.Flags[prefix .. "_SecretID_" .. tostring(i)].CurrentValue or ""
        elseif UnitDatabase[selOpt] then
            unitRecord = UnitDatabase[selOpt]
            targetID = unitRecord.ID
        end

        local baseCF = positionsTable[i]

        if targetID ~= "" and baseCF then
            local result = SpawnTowerFunction:InvokeServer(targetID, baseCF, nil)
            if result then 
                table.insert(placedData, {Instance = result, Record = unitRecord, SelOpt = selOpt}) 
            end
            task.wait(0.2)
        end
    end

    task.wait(0.5)
    for _, data in ipairs(placedData) do
        if UpgradeTowerFunction then
            pcall(function()
                if typeof(data.Instance) == "Instance" then
                    UpgradeTowerFunction:InvokeServer(data.Instance)
                elseif data.Record and data.Record.UpgradeName then
                    AdvancedUpgrade(data.Record.UpgradeName)
                end
            end)
            task.wait(0.2)
        end
    end
end

